        "content": "Dark & Light Themes Example:",
        "type": "paragraph",
        "typeOf": "Text"
    },
    "content14": {
        "content": "MaterialApp(\n  theme: ThemeData.light(),\n  darkTheme: ThemeData.dark(),\n  themeMode: ThemeMode.system,\n)",
