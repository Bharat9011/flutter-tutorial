    "content8": {
        "content": "Default Material Theme Example:",
        "type": "paragraph",
        "typeOf": "Text"
    },
    "content9": {
        "content": "MaterialApp(\n  theme: ThemeData(\n    primarySwatch: Colors.blue,\n    fontFamily: 'Roboto',\n  ),\n  home: MyHomePage(),\n)",
        "type": "code",
        "typeOf": "code"
    },
    "content10": {
