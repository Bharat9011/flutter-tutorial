    "content16": {
        "content": "🔄 Overriding Theme Styles Locally",
        "type": "sub-heading",
        "typeOf": "Text"
    },
    "content17": {
        "content": "You can override the theme for specific widgets using Theme.with:",
        "type": "paragraph",
        "typeOf": "Text"
    },
    "content18": {
        "content": "Theme(\n  data: Theme.of(context).copyWith(\n    primaryColor: Colors.red,\n  ),\n  child: ElevatedButton(...),\n)",
        "type": "code",
        "typeOf": "code"
    },
    "content19": {
        "content": {
            "index": 3,
            "question": "What is the correct way to override ONLY the primary color for a specific widget subtree?",
            "option": [
                "Using ThemeData.setPrimaryColor()",
