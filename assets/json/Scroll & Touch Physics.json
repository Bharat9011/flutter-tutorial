    "content3": {
        "content": "1. BouncingScrollPhysics",
        "type": "sub-heading",
        "typeOf": "Text"
    },
    "content4": {
        "content": "Standard on iOS. The list bounces back when overscrolled.",
        "type": "paragraph",
        "typeOf": "Text"
    },
    "content5": {
        "content": "ListView(\n  physics: BouncingScrollPhysics(),\n  children: [...],\n)",
        "type": "code",
