    "content27": {
        "content": "Rules for Perfect Variable Declaration",
        "type": "heading",
        "typeOf": "Text"
    },
    "content28": {
        "content": "Follow these essential rules to create well-defined variables in any programming language:",
        "type": "paragraph",
        "typeOf": "Text"
    },
    "content29": {
        "content": [
            {
                "number": 1,
                "title": "Naming Conventions",
                "bullets": [
                    "Use descriptive names (e.g., `studentCount` instead of `x`)",
                    "Follow language-specific casing:",
                    "camelCase (Java/JavaScript): `totalAmount`",
                    "snake_case (Python): `total_amount`",
                    "PascalCase (C#): `TotalAmount`",
                    "Avoid reserved keywords (e.g., `class`, `int`, `return`)",
                    "Begin with letters (never numbers or symbols)"
                ]
            },
            {
                "number": 2,
                "title": "Type Selection",
                "bullets": [
                    "Match the data type to your data:",
                    "Whole numbers → `int`",
                    "Decimals → `float`/`double`",
                    "True/False → `boolean`",
                    "Text → `String`/`str`",
                    "Use the most specific type possible (e.g., `byte` instead of `int` for small numbers)"
                ]
            },
            {
                "number": 3,
                "title": "Scope Management",
                "bullets": [
                    "Limit scope to where it's needed:",
                    "Local variables: Declare closest to usage point",
                    "Global variables: Use sparingly with clear justification",
                    "Use proper access modifiers when applicable (public/private/protected)"
                ]
            },
            {
                "number": 4,
                "title": "Initialization Rules",
                "bullets": [
                    "Always initialize variables before use",
                    "Use meaningful default values:",
                    "`int count = 0`",
                    "`String name = \"\"`",
                    "`boolean isActive = false`",
                    "Avoid null values when possible (use Optional in Java, nullable types in Kotlin)"
                ]
            },
            {
                "number": 5,
                "title": "Mutability Control",
                "bullets": [
                    "Prefer immutability when possible:",
                    "Use `final` (Java), `const` (Dart), `let` (JavaScript) for constants",
                    "Mark variables as read-only after initialization",
                    "Only make variables muTable when values need to change"
                ]
            }
        ],
        "type": "List",
        "typeOf": "List-Text-number"
    },
