{
    "content1": {
        "content": "Firebase Analytics & Crashlytics",
        "type": "heading",
        "typeOf": "Text"
    },
    "content2": {
        "content": "Analytics helps you understand how people use your app, while Crashlytics helps you track, prioritize, and fix stability issues that erode app quality.",
        "type": "paragraph",
        "typeOf": "Text"
    },
    "content3": {
        "content": "1. Analytics Setup",
        "type": "sub-heading",
        "typeOf": "Text"
    },
    "content4": {
        "content": "dependencies:\n  firebase_analytics: ^10.8.0",
        "type": "code",
        "typeOf": "code"
    },
    "content5": {
        "content": "Log custom events to track specific user actions:",
        "type": "paragraph",
        "typeOf": "Text"
    },
    "content6": {
        "content": "await FirebaseAnalytics.instance.logEvent(\n  name: \"select_content\",\n  parameters: {\n    \"content_type\": \"image\",\n    \"item_id\": \"P12453\",\n  },\n);",
        "type": "code",
        "typeOf": "code"
    },
    "content7": {
        "content": "2. Crashlytics Setup",
        "type": "sub-heading",
        "typeOf": "Text"
    },
    "content8": {
        "content": "dependencies:\n  firebase_crashlytics: ^3.4.9",
        "type": "code",
        "typeOf": "code"
    },
    "content9": {
        "content": "Pass all uncaught errors to Crashlytics:",
        "type": "paragraph",
        "typeOf": "Text"
    },
    "content10": {
        "content": "FlutterError.onError = FirebaseCrashlytics.instance.recordFlutterFatalError;",
        "type": "code",
        "typeOf": "code"
    },
    "content11": {
        "content": "Summary",
        "type": "heading",
        "typeOf": "Text"
    },
    "content12": {
        "content": "Together, these tools provide a comprehensive view of your app's health and user engagement.",
        "type": "paragraph",
        "typeOf": "Text"
    },
    "content13": {
        "content": "break",
        "type": "break",
        "typeOf": "break"
    }
}